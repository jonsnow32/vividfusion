<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <!-- Exclude sensitive auth tokens and ad preferences from cloud backup -->
    <exclude domain="sharedpref" path="accounts_preference.xml" />
    <exclude domain="sharedpref" path="open_subtitle_prefs.xml" />
    <!-- Exclude all debrid tokens -->
    <exclude domain="sharedpref" path="realdebrid_prefs.xml" />
    <exclude domain="sharedpref" path="alldebrid_prefs.xml" />
    <exclude domain="sharedpref" path="premiumize_prefs.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="accounts_preference.xml" />
  </device-transfer>
</data-extraction-rules>
