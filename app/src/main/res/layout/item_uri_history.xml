<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="8dp"
  android:clickable="true"
  android:focusable="true"
  app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
  app:cardCornerRadius="12dp"
  app:cardElevation="0dp"
  app:strokeColor="?attr/colorOutlineVariant"
  app:strokeWidth="0.5dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
      android:id="@+id/imgUriType"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_marginEnd="12dp"
      android:src="@drawable/ic_stream_outline_24"
      app:tint="?attr/colorPrimary"
      tools:ignore="ContentDescription" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical"
      android:paddingTop="8dp"
      android:paddingBottom="8dp">

      <TextView
        android:id="@+id/tvUriTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Big Buck Bunny"
        tools:visibility="visible" />

      <TextView
        android:id="@+id/tvUriHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        tools:text="http://example.com/video.mp4" />

    </LinearLayout>

    <ImageButton
      android:id="@+id/btnDeleteHistory"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/action_delete"
      android:padding="8dp"
      android:src="@drawable/ic_delete"
      app:tint="?attr/colorOnSurfaceVariant" />

  </LinearLayout>

</com.google.android.material.card.MaterialCardView>
